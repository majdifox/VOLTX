# Backend Dockerfile
FROM openjdk:17-jdk-slim

WORKDIR /app

# Copy Maven wrapper and pom.xml
COPY VoltX_Backend/mvnw VoltX_Backend/mvnw.cmd ./
COPY VoltX_Backend/.mvn .mvn
COPY VoltX_Backend/pom.xml ./

# Download dependencies
RUN chmod +x mvnw && ./mvnw dependency:go-offline

# Copy source code
COPY VoltX_Backend/src ./src

# Build application
RUN ./mvnw clean package -DskipTests

# Expose port
EXPOSE 8080

# Run application
CMD ["java", "-jar", "target/voltx-backend-0.0.1-SNAPSHOT.jar"]